<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/css/home.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Italiano</title>
    <link rel="icon" type="image/png" href="/img/pizza.png" />
    <script defer src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script defer type="module" src="/js/home.js"></script>
</head>
<body>
   <div class="sidebar">
            <div class="sidebar-brand">
                <h2><span><i class="fab fa-accusoft"></i></span><span id="kleenpulse">Italiano</span></h2>
            </div>
            <div class="sidebar-menu">
                <ul>
                    <li>
                        <a href="/admin" class="active"><span class="fas fa-cubes"></span>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/user/all"><span class="fas fa-users"></span>
                            <span>Customers</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/product/all"><span class="fas fa-clipboard-list"></span>
                            <span>Products</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/getOrders"><span class="fas fa-shopping-bag"></span>
                            <span>Orders</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/signup"><span class="fas fa-receipt"></span>
                            <span>Signup</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/login"><span class="fa fa-user-circle"></span>
                            <span>login</span>
                        </a>
                    </li>
                    <li>
                        <a href="/"><span class="fas fa-clipboard"></span>
                            <span>Contact</span>
                        </a>
                    </li>
                </ul>
            </div>
    </div>
    <div class="main-wrapper">
    <div class="main-content">
            <header>
                <h2 class="heading" id="dashboard">
                    Dashboard
                    </h2>
                    <label for="nav-toggle">
                        <span class="fas fa-bars"></span>
                    </label>
               



                <div class="user-wrapper">
                    <img style="width: 60px; height: 60px;"  src="/img/pizza.png"
                        alt="">
                    <div>
                        <h4>Italiano</h4>
                        <b>C E O</b></small>
                    </div>
                </div>
            </header>
            <main>

                <div class="cards">
                    <div class="card-single">
                        <div>
                            <h1 id="customer"></h1>
                            <span>Happy Clients</span>
                        </div>
                        <div>
                            <span class="fas fa-users"></span>
                        </div>
                    </div>
                    <div class="card-single">
                        <div>
                            <h1 id="project"></h1>
                            <span>Meals Prepared!</span>
                        </div>
                        <div>
                            <span class="fas fa-clipboard"></span>
                        </div>
                    </div>
                    <div class="card-single">
                        <div>
                            <h1 id="order"></h1>
                            <span>Confirmed Orders</span>
                        </div>
                        <div>
                            <span class="fas fa-shopping-bag"></span>
                        </div>
                    </div>
                    <div class="card-single">
                        <div>
                            <h1><sup>$</sup>
                                <p id="income"><b>k</b></p>
                            </h1>
                            <span>yearly Income</span>
                        </div>
                        <div>
                            <span class="fab fa-google-wallet"></span>
                        </div>
                    </div>
                </div>
                <div class="recent-grid">
  <div class="projects">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="heading">Recently added products</h3>
                                <button onclick="window.location.href='/admin/product/all'"> See all <span class="fas fa-arrow-right"></span></button>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table width="100%">
                                        <thead>
                                            <tr>
                                                <td scope="col">Products</td>
                                                <td scope="col" >Product type</td>
                                                <td scope="col">Status</td>
                                            </tr>
                                        </thead>
                                        <% products.slice(0,12).map(function(value){ %>
                                        <tbody>
                                            <tr>
                                                <td><%= value.productName %></td>
                                                <td><%= value.productCollection %></td>
                                                <td>
                                                    <span class="status purple"></span><%= value.productStatus %>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <% }) %>

                                    </table>
                                </div>
                            </div>
                        </div>
                   </div>
            
                    <div class="customers">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="heading">new customers</h3>
                                <button onclick="window.location.href='/admin/user/all'">Sell all<span class="fas fa-arrow-right"></span></button>
                            </div>
                             <%  members.slice(0,4).map(function(value) { %>
                            <div class="card-body">
                                
                                <div class="customer">
                                    <div class="info">
                                        <img  style="width: 50px; height: 50px;" src="/img/pizza.png"
                                            alt="">
                                        <div>
                                            <h4><%= value.memberNick %></h4>
                                            <small><%= value.memberEmail %></small>
                                        </div>
                                    </div>
                                    <div class="contact">
                                        <span class="fas fa-user-circle"></span>
                                        <span class="fas fa-comment"></span>
                                        <span class="fas fa-phone"></span>
                                    </div>
                                  </div>
                                  <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
    
            </main>
    </div>
    </div>
    <video class="video-1" src="https://vxrcel-studio.vercel.app/abstract.mp4" loop muted autoplay></video>
    <video class="video-2" src="https://vxrcel-studio.vercel.app/darkwave.mp4" loop muted autoplay></video>
</body>
</html>