<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet"  href="/css/login.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Italiano</title>
    <link rel="icon" type="image/png" href="/img/pizza.png" />
</head>
<body>
    <div class="page">
  <div class="container">
    <div class="left">
      <div class="login">Login</div>
      <div class="eula"> Welcome to our restaurant <br> Go back <span><a class="nav-link active" href="/admin"><span>Home</span></a></span>  <br> Not registered yet? <span><a class="nav-link" href="/admin/signup"><span>Here</span></a></span></div>
    </div>
    <div class="right">
      <svg viewBox="0 0 320 300">
        <defs>
          <linearGradient
                          inkscape:collect="always"
                          id="linearGradient"
                          x1="13"
                          y1="193.49992"
                          x2="307"
                          y2="193.49992"
                          gradientUnits="userSpaceOnUse">
            <stop
                  style="stop-color:#45ffca;"
                  color: #45ffca;
                  offset="0"
                  id="stop876" />
            <stop
                  style="stop-color:#08805e;"
                  offset="1"
                  id="stop878" />
          </linearGradient>
        </defs>
        <path d="m 40,120.00016 239.99984,-3.2e-4 c 0,0 24.99263,0.79932 25.00016,35.00016 0.008,34.20084 -25.00016,35 -25.00016,35 h -239.99984 c 0,-0.0205 -25,4.01348 -25,38.5 0,34.48652 25,38.5 25,38.5 h 215 c 0,0 20,-0.99604 20,-25 0,-24.00396 -20,-25 -20,-25 h -190 c 0,0 -20,1.71033 -20,25 0,24.00396 20,25 20,25 h 168.57143" />
      </svg>
      <form action="/admin/login" method="POST">
      <div class="form">
        <label for="email">Email</label>
        <input 
            type="email" 
            id="email" 
            name="memberEmail"
            class="member-email"
            value=""
            required>
        <label for="password">Password</label>
        <input 
            type="password"
            id="password"
            name="memberPassword"
            class="member-password"
            value=""
            required>
        <input type="submit" id="submit" value="Submit">
      </div>
      </form>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
<script  src="/js/login.js"></script>
</body>
</html>