<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
   <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
      integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm"
      crossorigin="anonymous"
    />
  <link rel="stylesheet" href="/css/product.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Italiano</title>
    <link rel="icon" type="image/png" href="/img/pizza.png" />
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script defer src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script defer type="text/javascript" src="/js/product.js"></script>
</head>
<body>
   <div class="sidebar">
            <div class="sidebar-brand">
                <h2><span><i class="fab fa-accusoft"></i></span><span id="kleenpulse">Italiano</span></h2>
            </div>
            <div class="sidebar-menu">
                <ul>
                    <li>
                        <a href="/admin" class="active"><span class="fas fa-cubes"></span>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/user/all"><span class="fas fa-users"></span>
                            <span>Customers</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/product/all"><span class="fas fa-clipboard-list"></span>
                            <span>Products</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/getOrders"><span class="fas fa-shopping-bag"></span>
                            <span>Orders</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/signup"><span class="fas fa-receipt"></span>
                            <span>Signup</span>
                        </a>
                    </li>
                    <li>
                        <a href="/admin/login"><span class="fa fa-user-circle"></span>
                            <span>login</span>
                        </a>
                    </li>
                    <li>
                        <a href="/"><span class="fas fa-clipboard"></span>
                            <span>Contact</span>
                        </a>
                    </li>
                </ul>
            </div>
    </div>


    <div class="main-wrapper">
    <div class="main-content">
            <header>
                <h2 class="heading" id="dashboard">
                    Products
                    </h2>
                    <label for="nav-toggle">
                        <span class="fas fa-bars"></span>
                    </label>
                  
                <div class="search">
                    <div class="search-rotate">
                    <div class="icon"></div>
                    </div>
                    <div class="input">
                        <input type="text" placeholder="search" id="mysearch" autocomplete="off" onkeydown="display(this)">
                       
                    </div>
                    
                </div>
               



                <div class="user-wrapper">
                    <img style="width: 60px; height: 60px;"  src="/img/pizza.png"
                        alt="">
                    <div>
                        <h4>Italiano</h4>
                        <b>C E O</b></small>
                    </div>
                </div>
            </header>
            <main>
                <div id="pop-wrap">
                    <h1 class="pop-up">Light Mode Activated</h1>
                </div>
                <div class="switch" id="switch">
                    <div id="toggle">
                        <i class="fas fa-moon"></i>
                        <i class="fas fa-sun"></i>
                        <i class="indicator"></i>
    
                    </div>
                </div>
                <div class="projects">
                        <div class="card">
                        <div class="card-header">
                        <h3 class="heading">Our products</h3>
                        </div>
                        <div class="card-body">
                        <div class="table-responsive">
                        <table width="100%">
                        <thead>
                        <tr>
                        <td scope="col">T/r</td>   
                        <td scope="col">Product 🍕</td>
                        <td scope="col">Collection 🍛</td>
                        <td scope="col">Volume 🥡</td>
                        <td scope="col">Price 💵</td>
                        <td scope="col"> Portion 🍽️</td>
                        <td scope="col">Status ⏳</td>
                        </tr>
                        </thead>
                            <% products.map(function(value, key){ %>
                                    <tbody>
                                    <td><%= key +1 %></td>
                                    <td><%= value.productName %> </td>
                                    <td><%= value.productCollection %></td>
                                    <td><%= value.productCollection === "DRINK" ? value.productVolume : 
                                            value.productSize %></td>
                                    <td><%= value.productPrice %> 💲</td>
                                    <td><%= value.productLeftCount %></td>
                                    <td>
                                <select class="spec-select product-status" id="<%= value._id %>" style=" background-color: rgba(85, 83, 83, 0); border-radius: 9px;">
                                    <option value="PAUSE" <%= value.productStatus=== "PAUSE" ? "selected": " " %>>PAUSE</option>
                                    <option value="PROCESS" <%= value.productStatus=== "PROCESS" ? "selected": " " %>>PROCESS</option>
                                    <option value="DELETE"  <%= value.productStatus=== "DELETE" ? "selected": " " %>>DELETE</option>
                                </select>
                            </td>
                        </tbody>
                    <%}) %>
                </table>
             </div>
         </div>
        </div>
    </div>
          <div class="card-header">
                                <h3 class="heading">Adding product is here</h3>
                                <button id="process-btn"> New Product <span class="fas fa-arrow-right" ></span></button>
                            </div>
                            <form
                            onsubmit="return validateForm()"
                             action="/admin/product/create"
                             method="POST"
                             class="dish-container"
                             enctype="multipart/form-data"
                            >

                            <div class="projects">
                                <div class="card">
                                <div class="card-new">
                                <h3 class="heading-new">New product</h3>
                                </div>
                                    <div class="name-status-frame">
                                        <div class="name-frame">
                                            <label>Product Name</label>
                                            <input 
                                               type="text"
                                               placeholder="Name"
                                               name="productName"
                                               class="product-name"/>
                                        </div>
                                        <input 
                                           value="PAUSE"
                                           name="productStatus"
                                           class="product-status"
                                           hidden
                                           />
                                    </div>
                                    <div class="price-left-frame">
                                        <div class="price-frame">
                                            <label>Product Price</label>
                                            <input 
                                              type="number"
                                              placeholder="Price"
                                              name="productPrice"
                                              class="product-price"
                                            />
                                        </div>
                                        <div class="price-frame">
                                            <label>Product Portion</label>
                                            <input 
                                               type="number"
                                               placeholder="Portions"
                                               name="productLeftCount"
                                               class="product-left-count"
                                               />
                                        </div>
                                    </div>
                                    <div class="price-left-frame">
                                        <div class="price-frame">
                                            <label>Product Type</label>
                                            <select class="product-collection" name="productCollection">
                                                <option value="DINNER">DINNER</option>
                                                <option value="LUNCH">LUNCH</option>
                                                <option value="SALAD">SALAD</option>
                                                <option value="DESSERT"> DESSERT</option>
                                                <option value="DRINK">DRINK</option>
                                                <option value="OTHER">OTHER</option>
                                            </select>
                                        </div>
                                        <div class="price-frame" id="product-collection">
                                            <label>Food Size</label>
                                            <select class="product-size" name="productSize">
                                                <option value="SMALL">SMALL</option>
                                                <option value="NORMAL">NORMAL</option>
                                                <option value="LARGE">LARGE</option>
                                                <option value="SET">SET</option>
                                            </select>
                                        </div>
                                        <div class="price-frame" id="product-volume" style="display: none;">
                                            <label>Drink Size</label>
                                            <select name="product-volume" class="productVolume">
                                                <option value="o.5">0.5 liters</option>
                                                <option value="1">1 liters</option>
                                                <option value="1.2">1.2 liters</option>
                                                <option value="1.5">1.5 liters</option>
                                                <option value="2">2 liters</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="desc-input">
                                        <label>Product Production</label>
                                        <textarea name="productDesc" class="product-desc"></textarea>
                                    </div>
                                    <div class="img-frame">
                                        <label>Product Image</label>
                                        <div class="media-frame">
                                            <div class="upload-img-box">
                                                <img src="/img/download.png" class="1" id="image-section-1"/>
                                                <input 
                                                  type="file"
                                                  id="file"
                                                  name="productImages"
                                                  class="image-one"
                                                  required
                                                  onchange="previewFileHandler(this,1)"
                                                  />
                                            </div>
                                            <div class="upload-img-box">
                                                <img src="/img/download.png" class="2" id="image-section-2"/>
                                                <input 
                                                  type="file"
                                                  id="file"
                                                  name="productImages"
                                                  class="image-two"
                                                  onchange="previewFileHandler(this, 2)"
                                                  />
                                            </div>
                                            <div class="upload-img-box">
                                                <img src="/img/download.png" class="3" id="image-section-3"/>
                                                <input 
                                                  type="file"
                                                  id="file"
                                                  name="productImages"
                                                  class="image-three"
                                                  onchange="previewFileHandler(this, 3)"
                                                  />
                                            </div>
                                            <div class="upload-img-box">
                                                <img src="/img/download.png" class="4" id="image-section-4"/>
                                                <input 
                                                  type="file"
                                                  id="file"
                                                  name="productImages"
                                                  class="image-four"
                                                  onchange="previewFileHandler(this, 4)"
                                                  />
                                            </div>
                                            <div class="upload-img-box">
                                                <img src="/img/download.png" class="5" id="image-section-5"/>
                                                <input 
                                                  type="file"
                                                  id="file"
                                                  name="productImages"
                                                  class="image-five"
                                                  onchange="previewFileHandler(this, 5)"
                                                  />
                                            </div>
                                            <input name="restaurantId" class="restaurant-id" hidden/>
                                        </div>
                                    </div>
                                    <div class="operation-buttons">
                                        <button class="btn btn-danger" id="cancel-btn">Cancel</button>
                                        <button type="submit" class="btn btn-primary" id="create-btn"> Create</button>
                                    </div>
                                 </div>


                            </div>
                            

                                
                            </form>
 </main>
            <div class="footer">
        <div class="word">
    
            <p style="padding-left: 190px;">Since <span id="hrt"><i class="far fa-heart"></i></span> | Italiano 2022 - <span id="full-year"></span></p>
        </div>
    </div>
    </div>
    </div>
    <video class="video-1" src="https://vxrcel-studio.vercel.app/abstract.mp4" loop muted autoplay></video>
    <video class="video-2" src="https://vxrcel-studio.vercel.app/darkwave.mp4" loop muted autoplay></video>
    
</body>
</html>